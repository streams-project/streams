target/
node_modules/
dist/
.venv/
.DS_Store
*.env
.env*

# Source packs are separate programs in their own repositories.
/packs/

# Built by ./up.
/bin/
/apps/web/dist/

# Rendered films hold title art and stay out of the repository.
/brand/*/media/
__pycache__/

# Profile pictures stay private until the owner clears them for the public repository.
/brand/streams/avatars/

# Worktrees a helper opens inside the repository, so a wide add cannot swallow one as a submodule.
.claude/worktrees/
