#!/bin/sh
# Every check this repository has, in one place. CI runs this file and nothing else.
#
# What it does not cover, so nobody reads a green run as more than it is: the device app builds
# (the android APK and its lint, the two apple apps under apps/apple/App and apps/apple/PhoneApp,
# a browser for the television page), the instrumented tests that need a device, the release
# profiles, the dependency advisories in server/deny.toml, which need a network database, the tests
# marked ignored, and whichever generated client types this machine has no compiler for, which
# check_types.py names as it goes.
# The android surfaces' unit tests do run, on a machine that has a JDK and an SDK, and the apple
# surfaces' unit tests run on a machine that has Xcode; check_android.py and check_apple.py each
# say on every run which of them they could not run, and why. On a machine with no compiler for any
# of the three, that step fails rather than passing: CI installs TypeScript so one is always proved.
set -eu
cd "$(dirname "$0")"

# Before anything else: this proves the tree in git, not the tree on this disk. A file that is
# here and not committed breaks a fresh clone, and every other step below would still pass.
python3 platform/tools/check_tracked.py

# These two only read files, so they run before anything is built.
# Nothing private is in any file. The data builder scans the folder it builds from; this reads the
# whole repository, because the leak that started this check was in a tool under platform/.
python3 platform/tools/check_private.py

# Every word on every screen, in every language, with the same holes to fill as English.
python3 platform/tools/check_strings.py

# No public file claims a size that nothing measures.
python3 platform/tools/check_claims.py

# The android app strips the core it packages, and keeps the symbols to read a crash with. Read
# from the build files, because this check does not run gradle.
python3 platform/tools/check_android_native.py

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked

# Every app family is its own hexagon.
python3 platform/tools/check_rings.py

# The core still fits a browser and a television. contract-proto is in this line and not only in
# the workspace build because the whole size case for a binary wire rests on prost being no_std:
# the crate is `#![no_std]` with `alloc`, which is the shape the core is in, and this is what
# notices the day a std dependency arrives in it.
cargo build --locked -p core -p contract -p offline -p contract-proto --target wasm32v1-none
cargo clippy --locked -p bridge-wasm --target wasm32v1-none -- -D warnings
cargo test --locked -p bridge-c --no-default-features

# The contract, its ledger and what is generated from it.
(
  cd platform
  python3 tools/ledger.py check
  python3 tools/test_ledger.py
  cargo run --locked -p contract-gen -- write
  git diff --exit-code -- contract/generated
  test -z "$(git status --porcelain -- contract/generated)"
  # The same contract as a protobuf schema, which arrives BESIDE the JSON one and not instead of
  # it. Every value rule is declared once, as a field option, and this program writes all 185
  # validators out of the descriptor - so a rule cannot be stated twice and disagree with itself,
  # which is what the title id rule does today: a comparison in contract/src/title.rs and a hand
  # expanded regular expression beside it, agreeing only because check_patterns.py compares them.
  # `-- check` writes nothing and exits 1 on drift, and the git lines cover the types and the
  # descriptor, which contract-proto/build.rs writes.
  cargo run --locked -p contract-validate-gen -- check
  git diff --exit-code -- contract-proto/generated
  test -z "$(git status --porcelain -- contract-proto/generated)"
  # The ledger and the schema, tied in both directions: every row that names a path finds it, and
  # every message is reachable from a row or a fixture. The tie is a sidecar and not an eighth
  # ledger column because `ledger.py generate` rewrites ledger.csv from its plan; running it here
  # is what stops the two drifting. The second line breaks each of its rules on purpose, so this
  # check cannot go quiet without a red run.
  python3 -I tools/check_proto_tie.py
  python3 -I tools/check_proto_tie.py --selftest
  python3 tools/test_fake_server.py
  python3 tools/test_port_help.py
  # The expression every generated client compiles into itself refuses exactly what the core
  # refuses: same text everywhere, same verdict on every fixture, same bound as the Rust constant.
  python3 tools/check_patterns.py
  # The generated types really compile, and a fixture reads and writes back the same. A language
  # whose compiler this machine has not got is printed as not run, by name, and counted.
  python3 tools/check_types.py
  # The checks themselves, each test named after the defect it keeps shut.
  python3 tools/test_check_patterns.py
  python3 tools/test_check_tracked.py
  python3 tools/test_check_private.py
  python3 tools/test_check_rings.py
  python3 tools/test_check_types.py
  python3 tools/test_check_claims.py
  python3 tools/test_check_android_native.py
  python3 tools/test_check_android.py
  python3 tools/test_check_apple.py
)

# Every id a server test name claims must be a real ledger row.
(cd server && python3 scripts/check_test_ids.py)

# The data builder, which also cross checks the contract and the server.
(cd data && ./scripts/check)

# Last, because it is the only step that builds anything with Gradle and the only one that can
# want the network: the Android surfaces' own unit tests, 219 of them on 2026-11-13, which until
# today nothing here ran. On a machine with no JDK or no Android SDK - which CI is, because the
# workflow deletes /usr/local/lib/android for disk - it prints what it could not check and passes,
# the way check_types.py does for a language whose compiler is absent. Measured on the machine it
# landed on, 2026-11-13: 5 seconds with nothing to do, 28 to 55 when a module must rerun its tests.
# A machine that has never run them pays minutes more the first time, for the Robolectric jars.
python3 platform/tools/check_android.py

# And the Apple surfaces' own unit tests, 62 of them on 2026-11-13, which until today nothing here
# ran either - and which everyone believed this family's machines could not run, because
# `swift build` says "no such module 'UIKit'". It says that because it has no simulator SDK unless
# it is handed one; xcodebuild takes one from the destination, and both simulator SDKs were
# installed all along. On a machine with no Xcode - which CI is, because it runs on ubuntu-24.04 -
# it prints what it could not check and passes, the way check_android.py does for a missing SDK.
# It is last because it is the slowest step here, by a long way. Measured on the machine it landed
# on, 2026-11-13: 77 seconds with the package already built, and 160 to 190 when it must be rebuilt
# or the machine is busy. Most of that is two simulators booting, not the tests, which take 17
# seconds between them. Nothing here keeps a simulator booted afterwards; one that a person already
# has open is used, and saves most of its half.
python3 platform/tools/check_apple.py
