<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this device. The session token sits in this app's own storage, and a token belongs
  to the device the viewer signed in on: it must not ride a cloud backup or a transfer to a new
  phone. This is the Android 12 and later half of the rule; android:allowBackup="false" is the rest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
