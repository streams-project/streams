<?xml version="1.0" encoding="utf-8"?>
<!--
  Default fail-closed policy: HTTPS everywhere.
  When `:app` is built with a plain http:// bound server on the viewer's own network,
  `app/build.gradle.kts` (`prepareBoundNetworkSecurity`) generates a build-time variant
  overlay permitting cleartext traffic only for that bound host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
