<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw a splash before the first frame. It is the brand's background
         with no icon: the opening draws the mark itself, from dark, as its first stage. -->
    <style name="Launch" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
