{
  "$defs": {
    "KeyDelivery": {
      "description": "Where a protected stream's keys come from.\n\nA path, never an address, as an http effect is. The host holds the base address, so the\nlicence server is the same server the core already talks to, and there is nowhere in this\ntype to name another one.",
      "properties": {
        "certificate_path": {
          "description": "Where the key system's server certificate is read, for the systems that ask for one\nbefore the first request. A path, never an address.",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Headers the player must send with the licence request.",
          "type": "object"
        },
        "path": {
          "description": "A path, never an address.",
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/KeySystem"
        }
      },
      "required": [
        "system",
        "path"
      ],
      "type": "object"
    },
    "KeySystem": {
      "description": "A key system a player can open a protected stream with. The word is the contract's own;\neach adapter maps it to the name its platform uses.",
      "enum": [
        "widevine",
        "play_ready",
        "fair_play",
        "clear_key"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A command to the player. Attempts carry their headers here.",
  "oneOf": [
    {
      "properties": {
        "generation": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "key": {
          "$ref": "#/$defs/KeyDelivery",
          "description": "Absent for a stream that needs no key, which is every stream today."
        },
        "max_bitrate": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "max_height": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "const": "open",
          "type": "string"
        },
        "start_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "url",
        "headers",
        "start_at_ms",
        "generation"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "play",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "pause",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "seek",
          "type": "string"
        },
        "to_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "to_ms"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "rate",
          "type": "string"
        },
        "percent": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "percent"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "volume",
          "type": "string"
        },
        "percent": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "op",
        "percent"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "select_audio",
          "type": "string"
        },
        "track": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "track"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "select_text",
          "type": "string"
        },
        "track": {
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    {
      "properties": {
        "op": {
          "const": "close",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    }
  ],
  "title": "DriverCommand"
}
