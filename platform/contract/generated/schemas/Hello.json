{
  "$defs": {
    "BrandValues": {
      "description": "Name and contact, filled into text at render time.",
      "properties": {
        "name": {
          "type": "string"
        },
        "support_email": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "support_email"
      ],
      "type": "object"
    },
    "ClassValue": {
      "description": "One value per client class.",
      "properties": {
        "class": {
          "$ref": "#/$defs/DeviceClass"
        },
        "value": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "value"
      ],
      "type": "object"
    },
    "ClientFloor": {
      "description": "Lowest app version a class may run.",
      "properties": {
        "class": {
          "$ref": "#/$defs/DeviceClass"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "class",
        "version"
      ],
      "type": "object"
    },
    "DeviceClass": {
      "description": "Client class. Minimum versions, start deadlines and reachability are kept per class.",
      "enum": [
        "web",
        "phone",
        "tablet",
        "desktop",
        "tv",
        "box",
        "car"
      ],
      "type": "string"
    },
    "Features": {
      "description": "Feature values. With no answer from the server, accounts are required.",
      "properties": {
        "accounts_required": {
          "default": true,
          "type": "boolean"
        },
        "clips": {
          "default": false,
          "type": "boolean"
        },
        "games": {
          "default": false,
          "type": "boolean"
        },
        "original_audio": {
          "default": false,
          "type": "boolean"
        },
        "visitor_tier": {
          "description": "Tier for visitors. Present only when accounts are not required.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Limits": {
      "description": "Limits served from one place, so no client holds a copy.",
      "properties": {
        "blocked_title_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "blocked_titles_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "code_digits": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "code_valid_s": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "command_batch_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "handle_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "handle_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "password_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "phone_digits_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "phone_digits_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "pin_digits": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "profile_name_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "profiles_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "step_up_s": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profiles_max",
        "profile_name_max",
        "pin_digits",
        "password_min",
        "step_up_s",
        "phone_digits_min",
        "phone_digits_max",
        "blocked_title_max",
        "blocked_titles_max",
        "name_max",
        "handle_min",
        "handle_max",
        "code_digits",
        "code_valid_s",
        "command_batch_max"
      ],
      "type": "object"
    },
    "MovedAddress": {
      "description": "One row of the moved address table.",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Rollout": {
      "description": "A staged rollout. The bucket comes from the household, so a home moves together.",
      "properties": {
        "name": {
          "type": "string"
        },
        "percent": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "percent"
      ],
      "type": "object"
    },
    "VersionRange": {
      "description": "The wire dates a server answers. Never compared for equality.",
      "properties": {
        "max": {
          "$ref": "#/$defs/WireDate"
        },
        "min": {
          "$ref": "#/$defs/WireDate"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "WireDate": {
      "description": "A wire date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "First answer a client reads.",
  "properties": {
    "brand": {
      "$ref": "#/$defs/BrandValues"
    },
    "client_min": {
      "items": {
        "$ref": "#/$defs/ClientFloor"
      },
      "type": "array"
    },
    "contract": {
      "$ref": "#/$defs/VersionRange",
      "description": "Wire dates this server answers."
    },
    "features": {
      "$ref": "#/$defs/Features"
    },
    "killed_builds": {
      "description": "Builds refused by name.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "moved": {
      "items": {
        "$ref": "#/$defs/MovedAddress"
      },
      "type": "array"
    },
    "playback": {
      "description": "False stops playback everywhere with a notice.",
      "type": "boolean"
    },
    "rollouts": {
      "items": {
        "$ref": "#/$defs/Rollout"
      },
      "type": "array"
    },
    "start_deadline_ms": {
      "items": {
        "$ref": "#/$defs/ClassValue"
      },
      "type": "array"
    },
    "ttl_s": {
      "description": "Seconds this answer stays good.",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "client_min",
    "features",
    "limits",
    "playback",
    "start_deadline_ms",
    "brand",
    "ttl_s"
  ],
  "title": "Hello",
  "type": "object"
}
