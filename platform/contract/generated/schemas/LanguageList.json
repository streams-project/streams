{
  "$defs": {
    "Language": {
      "description": "A language this server has text for, named in itself.",
      "properties": {
        "code": {
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/TextDirection",
          "default": "ltr"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "type": "object"
    },
    "TextDirection": {
      "description": "Which way a language's lines run. The apps lay out, mirror and move focus by it; the player's\ntimeline and the brand's art never turn.",
      "enum": [
        "ltr",
        "rtl"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "languages": {
      "items": {
        "$ref": "#/$defs/Language"
      },
      "type": "array"
    }
  },
  "required": [
    "languages"
  ],
  "title": "LanguageList",
  "type": "object"
}
