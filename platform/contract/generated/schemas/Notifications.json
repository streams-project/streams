{
  "$defs": {
    "Badge": {
      "description": "A mark on a tile.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/BadgeKind"
        },
        "rank": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "BadgeKind": {
      "description": "Marks on a tile.",
      "enum": [
        "ranked",
        "new"
      ],
      "type": "string"
    },
    "CalendarDay": {
      "description": "A day of the calendar, YYYY-MM-DD. The app writes it out in the viewer's own words.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "type": "string"
    },
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "Image": {
      "description": "One image address. Images go straight from the host to the viewer.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ImageRole"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "role",
        "url"
      ],
      "type": "object"
    },
    "ImageRole": {
      "description": "What an image is for.",
      "oneOf": [
        {
          "enum": [
            "poster",
            "backdrop",
            "logo",
            "still",
            "avatar"
          ],
          "type": "string"
        },
        {
          "const": "art",
          "description": "A tall picture of the title with no words on it, to fill a portrait screen.",
          "type": "string"
        }
      ]
    },
    "NoticeItem": {
      "description": "One item in the notification feed.",
      "properties": {
        "date": {
          "$ref": "#/$defs/CalendarDay"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        },
        "unread": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "tile",
        "date",
        "unread"
      ],
      "type": "object"
    },
    "NoticeKind": {
      "description": "What kind of notice this is.",
      "enum": [
        "new_arrival",
        "coming",
        "reminder_live",
        "new_season",
        "new_episode"
      ],
      "type": "string"
    },
    "Tile": {
      "description": "One title in a section.",
      "properties": {
        "badges": {
          "items": {
            "$ref": "#/$defs/Badge"
          },
          "type": "array"
        },
        "episode": {
          "$ref": "#/$defs/EpisodeRef"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/Image"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "percent": {
          "description": "Whole percent watched.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/TitleKey"
        }
      },
      "required": [
        "title",
        "name"
      ],
      "type": "object"
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):[1-9][0-9]{0,9}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`GET /v1/notifications`.",
  "properties": {
    "cursor": {
      "type": "string"
    },
    "has_more": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/NoticeItem"
      },
      "type": "array"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "title": "Notifications",
  "type": "object"
}
