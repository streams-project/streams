{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stable error code. A code this build does not know reads as `Unknown`.",
  "enum": [
    "bad_request",
    "unauthorized",
    "session_ended",
    "profile_required",
    "pin_required",
    "step_up_required",
    "refused",
    "not_found",
    "no_longer_available",
    "conflict",
    "rate_limited",
    "overloaded",
    "deadline_exceeded",
    "upgrade_required",
    "unsupported",
    "no_source",
    "clock_wrong",
    "internal"
  ],
  "title": "ErrorCode",
  "type": "string"
}
