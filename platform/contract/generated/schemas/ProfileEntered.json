{
  "$defs": {
    "Profile": {
      "description": "One profile.",
      "properties": {
        "avatar": {
          "type": "string"
        },
        "has_pin": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kids": {
          "type": "boolean"
        },
        "language": {
          "description": "A language code from `/v1/languages`, absent until one is chosen.",
          "type": "string"
        },
        "main": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kids",
        "main",
        "has_pin"
      ],
      "type": "object"
    },
    "ScreenName": {
      "description": "The screens the server builds.",
      "oneOf": [
        {
          "enum": [
            "home",
            "films",
            "series",
            "genre",
            "new",
            "my-list",
            "kids",
            "search",
            "notifications",
            "activity",
            "games",
            "clips",
            "language"
          ],
          "type": "string"
        },
        {
          "const": "mine",
          "description": "The viewer's own page: what they are watching, saved and liked.",
          "type": "string"
        },
        {
          "const": "help",
          "description": "Help. Its text comes from the help routes, so it has no page of rows.",
          "type": "string"
        },
        {
          "const": "settings",
          "description": "The viewer's settings, which also have no page of rows.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The profile answer names its home, so the core can map it to a target.",
  "properties": {
    "home": {
      "$ref": "#/$defs/ScreenName"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    }
  },
  "required": [
    "profile",
    "home"
  ],
  "title": "ProfileEntered",
  "type": "object"
}
