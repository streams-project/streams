{
  "$defs": {
    "Badge": {
      "description": "A mark on a tile.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/BadgeKind"
        },
        "rank": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "BadgeKind": {
      "description": "Marks on a tile.",
      "enum": [
        "ranked",
        "new"
      ],
      "type": "string"
    },
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "Image": {
      "description": "One image address. Images go straight from the host to the viewer.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ImageRole"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "role",
        "url"
      ],
      "type": "object"
    },
    "ImageRole": {
      "description": "What an image is for.",
      "oneOf": [
        {
          "enum": [
            "poster",
            "backdrop",
            "logo",
            "still",
            "avatar"
          ],
          "type": "string"
        },
        {
          "const": "art",
          "description": "A tall picture of the title with no words on it, to fill a portrait screen.",
          "type": "string"
        }
      ]
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One title in a section.",
  "properties": {
    "badges": {
      "items": {
        "$ref": "#/$defs/Badge"
      },
      "type": "array"
    },
    "episode": {
      "$ref": "#/$defs/EpisodeRef"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/Image"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "percent": {
      "description": "Whole percent watched.",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "$ref": "#/$defs/TitleKey"
    }
  },
  "required": [
    "title",
    "name"
  ],
  "title": "Tile",
  "type": "object"
}
