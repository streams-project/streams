{
  "$defs": {
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ask to play a title.",
  "properties": {
    "episode": {
      "$ref": "#/$defs/EpisodeRef"
    },
    "title": {
      "$ref": "#/$defs/TitleKey"
    }
  },
  "required": [
    "title"
  ],
  "title": "PlayRequest",
  "type": "object"
}
