{
  "$defs": {
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):[1-9][0-9]{0,9}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ask to play a title.",
  "properties": {
    "episode": {
      "$ref": "#/$defs/EpisodeRef"
    },
    "title": {
      "$ref": "#/$defs/TitleKey"
    }
  },
  "required": [
    "title"
  ],
  "title": "PlayRequest",
  "type": "object"
}
