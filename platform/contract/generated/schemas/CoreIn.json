{
  "$defs": {
    "Action": {
      "description": "What a screen asks for.",
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "sign_in",
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "email",
            "password"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "send_code",
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "email"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "sign_in_code",
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "email",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "Start device sign in. The core asks for a code, polls and renews it, and the screen\ndraws `View.device_sign_in`. While a code is live this changes nothing.",
          "properties": {
            "action": {
              "const": "device_sign_in",
              "type": "string"
            },
            "device_name": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "device_name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "device_sign_in_stop",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "sign_out",
              "type": "string"
            },
            "everywhere": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "everywhere"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "enter_profile",
              "type": "string"
            },
            "pin": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "profile"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "play",
              "type": "string"
            },
            "episode": {
              "$ref": "#/$defs/EpisodeRef"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "action",
            "title"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "pause",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "unpause",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "seek",
              "type": "string"
            },
            "to_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "to_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "select_audio",
              "type": "string"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "track"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "select_text",
              "type": "string"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "next_subtitle_file",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "command",
              "type": "string"
            },
            "command": {
              "$ref": "#/$defs/Command"
            }
          },
          "required": [
            "action",
            "command"
          ],
          "type": "object"
        },
        {
          "description": "Send a prepared request with this session's token. The http effect takes the id of\nthis event and its class is always plain, so whoever prepared it gets the answer\nunder that id. Tokens stay in the core.",
          "properties": {
            "action": {
              "const": "request",
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/HttpMethod"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "method",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "Command": {
      "description": "One change to a profile's facts.",
      "oneOf": [
        {
          "description": "Add to or remove from the saved list. Leaves the rating alone.",
          "properties": {
            "command": {
              "const": "list",
              "type": "string"
            },
            "in_list": {
              "type": "boolean"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title",
            "in_list"
          ],
          "type": "object"
        },
        {
          "description": "Set or clear a rating. Leaves the list entry alone.",
          "properties": {
            "command": {
              "const": "rate",
              "type": "string"
            },
            "rating": {
              "$ref": "#/$defs/Rating"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title"
          ],
          "type": "object"
        },
        {
          "description": "Hide a title from history. For a series this covers every episode.",
          "properties": {
            "command": {
              "const": "hide",
              "type": "string"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title"
          ],
          "type": "object"
        },
        {
          "description": "Clear all history of this profile, as one operation.",
          "properties": {
            "command": {
              "const": "clear_history",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "Save a position, in whole seconds.",
          "properties": {
            "command": {
              "const": "position",
              "type": "string"
            },
            "duration_s": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "episode": {
              "$ref": "#/$defs/EpisodeRef"
            },
            "position_s": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title",
            "position_s",
            "duration_s"
          ],
          "type": "object"
        },
        {
          "description": "Change one profile setting. Booleans as true or false, style as JSON text.",
          "properties": {
            "command": {
              "const": "setting",
              "type": "string"
            },
            "key": {
              "$ref": "#/$defs/SettingKey"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "key",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A viewer signal. Discarded by the server when consent is off.",
          "properties": {
            "command": {
              "const": "feedback",
              "type": "string"
            },
            "event": {
              "$ref": "#/$defs/FeedbackEvent"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title",
            "event"
          ],
          "type": "object"
        },
        {
          "description": "A trailer failed to play for this title.",
          "properties": {
            "command": {
              "const": "trailer_refused",
              "type": "string"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title"
          ],
          "type": "object"
        },
        {
          "description": "Set or clear a reminder on a coming title.",
          "properties": {
            "command": {
              "const": "remind",
              "type": "string"
            },
            "on": {
              "type": "boolean"
            },
            "title": {
              "$ref": "#/$defs/TitleKey"
            }
          },
          "required": [
            "command",
            "title",
            "on"
          ],
          "type": "object"
        }
      ]
    },
    "CoreInTag": {
      "description": "Type tag of `CoreIn`.",
      "enum": [
        "core_in"
      ],
      "type": "string"
    },
    "DriverEvent": {
      "description": "What the driver reports. No driver decides failover or no picture by itself.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "first_frame",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "duration_ms": {
              "description": "0 or absent when not known.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "has_picture": {
              "description": "Absent means unknown, and the no picture rule stays off.",
              "type": "boolean"
            },
            "kind": {
              "const": "position",
              "type": "string"
            },
            "time_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "video_width": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "stalled",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "ended",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "audio": {
              "items": {
                "$ref": "#/$defs/Track"
              },
              "type": "array"
            },
            "kind": {
              "const": "tracks",
              "type": "string"
            },
            "text": {
              "items": {
                "$ref": "#/$defs/Track"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "audio",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "class": {
              "$ref": "#/$defs/ErrorClass"
            },
            "kind": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "class"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "ErrorClass": {
      "description": "Failure classes a driver reports. The core picks the next attempt from these.",
      "enum": [
        "network",
        "manifest",
        "segment",
        "decode",
        "key",
        "format",
        "refused"
      ],
      "type": "string"
    },
    "Event": {
      "description": "One event. `id` is the id of the effect it answers, when it answers one.",
      "oneOf": [
        {
          "description": "An http effect got an answer. Every status is data.",
          "properties": {
            "body": {
              "description": "Absent when the body went to the screen.",
              "type": "string"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "status": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "http_done",
              "type": "string"
            }
          },
          "required": [
            "type",
            "status"
          ],
          "type": "object"
        },
        {
          "description": "An http effect got no answer at all.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/NoAnswerReason"
            },
            "type": {
              "const": "http_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "store_done",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "secret_done",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "timer_fired",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The host cannot perform this effect.",
          "properties": {
            "type": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The effect with this id was dropped.",
          "properties": {
            "type": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "suspend",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "resume",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "visibility",
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "visible"
          ],
          "type": "object"
        },
        {
          "properties": {
            "online": {
              "type": "boolean"
            },
            "type": {
              "const": "network",
              "type": "string"
            }
          },
          "required": [
            "type",
            "online"
          ],
          "type": "object"
        },
        {
          "description": "Touch, key, wheel or playing video in view.",
          "properties": {
            "type": {
              "const": "activity",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Another tab of this browser ended the session. The server has heard already.",
          "properties": {
            "type": {
              "const": "ended_elsewhere",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An address or deep link to open.",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "const": "address",
              "type": "string"
            }
          },
          "required": [
            "type",
            "address"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "$ref": "#/$defs/Action"
            },
            "type": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "type",
            "action"
          ],
          "type": "object"
        },
        {
          "description": "A driver event, stamped with the generation of the open that made it.",
          "properties": {
            "event": {
              "$ref": "#/$defs/DriverEvent"
            },
            "generation": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "driver",
              "type": "string"
            }
          },
          "required": [
            "type",
            "generation",
            "event"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "FeedbackEvent": {
      "description": "Signals a viewer gives.",
      "enum": [
        "click",
        "start",
        "complete",
        "like",
        "skip"
      ],
      "type": "string"
    },
    "HttpMethod": {
      "description": "Methods of an http effect.",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "type": "string"
    },
    "NoAnswerReason": {
      "description": "Why an http effect got no answer. Any status at all is an answer.",
      "enum": [
        "offline",
        "timeout",
        "tls",
        "clock_wrong",
        "cancelled"
      ],
      "type": "string"
    },
    "Rating": {
      "description": "Rating words on the wire. Screens use the words like, love and dislike.",
      "enum": [
        "down",
        "up",
        "love"
      ],
      "type": "string"
    },
    "SettingKey": {
      "description": "Settings a queued command may change. Age rating and blocked titles are absent on\npurpose: they need a step up, so a queued write can never touch them.",
      "enum": [
        "autoplay_next",
        "autoplay_previews",
        "audio_language",
        "subtitle_language",
        "subtitle_style",
        "ui_language",
        "handle",
        "gender"
      ],
      "type": "string"
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):[1-9][0-9]{0,9}$",
      "type": "string"
    },
    "Track": {
      "description": "One audio or text track, with the tag the manifest gave it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "selected": {
          "description": "True for the track playing now.",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "WireDate": {
      "description": "A wire date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One step of input. Every input carries wall time and monotonic time.",
  "properties": {
    "contract": {
      "$ref": "#/$defs/WireDate"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "type": "array"
    },
    "mono_ms": {
      "description": "Monotonic time, ms. Restarts at boot.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "now_ms": {
      "description": "Wall time, ms since 1970.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/CoreInTag"
    }
  },
  "required": [
    "contract",
    "type",
    "now_ms",
    "mono_ms",
    "events"
  ],
  "title": "CoreIn",
  "type": "object"
}
