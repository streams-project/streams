{
  "$defs": {
    "BodyTarget": {
      "description": "Where the body of an answer goes. An answer outside 200 to 299 always comes to the core,\nbecause the core reads its error code.",
      "enum": [
        "core",
        "screen"
      ],
      "type": "string"
    },
    "BrandValues": {
      "description": "Name and contact, filled into text at render time.",
      "properties": {
        "name": {
          "type": "string"
        },
        "support_email": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "support_email"
      ],
      "type": "object"
    },
    "ClassValue": {
      "description": "One value per client class.",
      "properties": {
        "class": {
          "$ref": "#/$defs/DeviceClass"
        },
        "value": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "value"
      ],
      "type": "object"
    },
    "ClientFloor": {
      "description": "Lowest app version a class may run.",
      "properties": {
        "class": {
          "$ref": "#/$defs/DeviceClass"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "class",
        "version"
      ],
      "type": "object"
    },
    "CoreOutTag": {
      "description": "Type tag of `CoreOut`.",
      "enum": [
        "core_out"
      ],
      "type": "string"
    },
    "DeviceClass": {
      "description": "Client class. Minimum versions, start deadlines and reachability are kept per class.",
      "enum": [
        "web",
        "phone",
        "tablet",
        "desktop",
        "tv",
        "box",
        "car"
      ],
      "type": "string"
    },
    "DeviceSignInState": {
      "description": "Where a device sign in stands.",
      "oneOf": [
        {
          "const": "idle",
          "description": "Nothing is running: it was stopped, or a session opened.",
          "type": "string"
        },
        {
          "const": "waiting",
          "description": "The core polls. With no `user_code` yet, a code is on its way.",
          "type": "string"
        },
        {
          "const": "denied",
          "description": "The viewer said no on the approving screen. `Action::DeviceSignIn` starts again.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "The code ran out and a new one follows with no press.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "This server cannot do device sign in. `Action::DeviceSignIn` asks it again.",
          "type": "string"
        }
      ]
    },
    "DeviceSignInView": {
      "description": "Device sign in state for screens. A dead code is left out, so no screen can show one, and\nthe device code has no field here.",
      "properties": {
        "expires_in": {
          "description": "Seconds this code lives, counted from when it reached this view.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/DeviceSignInState"
        },
        "user_code": {
          "description": "The screen shows this even when it shows a QR code.",
          "type": "string"
        },
        "verification_uri": {
          "type": "string"
        },
        "verification_uri_complete": {
          "description": "The same address with the code in it, for a QR code.",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "DriverCommand": {
      "description": "A command to the player. Attempts carry their headers here.",
      "oneOf": [
        {
          "properties": {
            "generation": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "max_bitrate": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "max_height": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "open",
              "type": "string"
            },
            "start_at_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "url",
            "headers",
            "start_at_ms",
            "generation"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "play",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "pause",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "seek",
              "type": "string"
            },
            "to_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "to_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "rate",
              "type": "string"
            },
            "percent": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "percent"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "volume",
              "type": "string"
            },
            "percent": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "percent"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "select_audio",
              "type": "string"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "track"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "select_text",
              "type": "string"
            },
            "track": {
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "close",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        }
      ]
    },
    "Effect": {
      "description": "One effect. The result comes back as an event with this id.",
      "oneOf": [
        {
          "description": "A path, never an address. The host holds the base address.",
          "properties": {
            "body": {
              "type": "string"
            },
            "class": {
              "$ref": "#/$defs/HttpClass"
            },
            "deadline_ms": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "headers": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "kind": {
              "const": "http",
              "type": "string"
            },
            "method": {
              "$ref": "#/$defs/HttpMethod"
            },
            "path": {
              "type": "string"
            },
            "scope": {
              "description": "Opaque scope of an account and profile, for kept copies.",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/BodyTarget"
            }
          },
          "required": [
            "kind",
            "method",
            "path",
            "deadline_ms",
            "class",
            "to"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "store",
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/StoreOp"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "secret",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/SecretOp"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "op",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "after_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "timer",
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/TimerOp"
            }
          },
          "required": [
            "kind",
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "$ref": "#/$defs/DriverCommand"
            },
            "kind": {
              "const": "player",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        },
        {
          "description": "A one time notice or a kept page. Lasting state travels in `view`.",
          "properties": {
            "body": {
              "$ref": "#/$defs/ScreenBody"
            },
            "kind": {
              "const": "view",
              "type": "string"
            },
            "notice": {
              "$ref": "#/$defs/Notice"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "open",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/RouteTarget"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "kind": {
              "const": "log",
              "type": "string"
            },
            "level": {
              "$ref": "#/$defs/LogLevel"
            }
          },
          "required": [
            "kind",
            "level",
            "code"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "EndReason": {
      "description": "Why a session ended.",
      "enum": [
        "signed_out",
        "everywhere",
        "refused",
        "elsewhere"
      ],
      "type": "string"
    },
    "EpisodeRef": {
      "description": "One episode of a series. A film has none.",
      "properties": {
        "episode": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "season": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "season",
        "episode"
      ],
      "type": "object"
    },
    "Features": {
      "description": "Feature values. With no answer from the server, accounts are required.",
      "properties": {
        "accounts_required": {
          "default": true,
          "type": "boolean"
        },
        "clips": {
          "default": false,
          "type": "boolean"
        },
        "games": {
          "default": false,
          "type": "boolean"
        },
        "original_audio": {
          "default": false,
          "type": "boolean"
        },
        "visitor_tier": {
          "description": "Tier for visitors. Present only when accounts are not required.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "GateView": {
      "description": "True while the who is watching prompt should show.",
      "properties": {
        "ask": {
          "type": "boolean"
        }
      },
      "required": [
        "ask"
      ],
      "type": "object"
    },
    "Hello": {
      "description": "First answer a client reads.",
      "properties": {
        "brand": {
          "$ref": "#/$defs/BrandValues"
        },
        "client_min": {
          "items": {
            "$ref": "#/$defs/ClientFloor"
          },
          "type": "array"
        },
        "contract": {
          "$ref": "#/$defs/VersionRange",
          "description": "Wire dates this server answers."
        },
        "features": {
          "$ref": "#/$defs/Features"
        },
        "killed_builds": {
          "description": "Builds refused by name.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "moved": {
          "items": {
            "$ref": "#/$defs/MovedAddress"
          },
          "type": "array"
        },
        "playback": {
          "description": "False stops playback everywhere with a notice.",
          "type": "boolean"
        },
        "rollouts": {
          "items": {
            "$ref": "#/$defs/Rollout"
          },
          "type": "array"
        },
        "start_deadline_ms": {
          "items": {
            "$ref": "#/$defs/ClassValue"
          },
          "type": "array"
        },
        "ttl_s": {
          "description": "Seconds this answer stays good.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "client_min",
        "features",
        "limits",
        "playback",
        "start_deadline_ms",
        "brand",
        "ttl_s"
      ],
      "type": "object"
    },
    "HttpClass": {
      "description": "How an http effect may be handled.",
      "oneOf": [
        {
          "const": "command",
          "description": "Must reach the server. The offline layer keeps it when one is present.",
          "type": "string"
        },
        {
          "const": "cacheable",
          "description": "May be answered from a kept copy.",
          "type": "string"
        },
        {
          "const": "plain",
          "description": "The host performs it as it arrives.",
          "type": "string"
        }
      ]
    },
    "HttpMethod": {
      "description": "Methods of an http effect.",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "type": "string"
    },
    "Limits": {
      "description": "Limits served from one place, so no client holds a copy.",
      "properties": {
        "blocked_title_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "blocked_titles_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "code_digits": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "code_valid_s": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "command_batch_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "handle_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "handle_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "password_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "phone_digits_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "phone_digits_min": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "pin_digits": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "profile_name_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "profiles_max": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "step_up_s": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profiles_max",
        "profile_name_max",
        "pin_digits",
        "password_min",
        "step_up_s",
        "phone_digits_min",
        "phone_digits_max",
        "blocked_title_max",
        "blocked_titles_max",
        "name_max",
        "handle_min",
        "handle_max",
        "code_digits",
        "code_valid_s",
        "command_batch_max"
      ],
      "type": "object"
    },
    "LogLevel": {
      "description": "Log levels.",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "MovedAddress": {
      "description": "One row of the moved address table.",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Notice": {
      "description": "Text a client can draw with no other knowledge, including a client below the floor.",
      "properties": {
        "action_address": {
          "type": "string"
        },
        "action_label": {
          "type": "string"
        },
        "label": {
          "description": "Label key, for clients with the strings.",
          "type": "string"
        },
        "text": {
          "description": "Plain text in the viewer's language.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "type": "object"
    },
    "PlayState": {
      "description": "Where the play session stands.",
      "enum": [
        "resolving",
        "starting",
        "playing",
        "paused",
        "stalled",
        "switching",
        "ended",
        "failed"
      ],
      "type": "string"
    },
    "PlayView": {
      "description": "Play session state for screens.",
      "properties": {
        "attempt": {
          "type": "string"
        },
        "episode": {
          "$ref": "#/$defs/EpisodeRef"
        },
        "next_episode": {
          "$ref": "#/$defs/EpisodeRef",
          "description": "Absent on the last episode, so no screen offers one that does not exist."
        },
        "state": {
          "$ref": "#/$defs/PlayState"
        },
        "title": {
          "$ref": "#/$defs/TitleKey"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/TimeWindow"
          },
          "type": "array"
        }
      },
      "required": [
        "state",
        "title"
      ],
      "type": "object"
    },
    "Profile": {
      "description": "One profile.",
      "properties": {
        "avatar": {
          "type": "string"
        },
        "has_pin": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kids": {
          "type": "boolean"
        },
        "main": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kids",
        "main",
        "has_pin"
      ],
      "type": "object"
    },
    "ProfileList": {
      "properties": {
        "profiles": {
          "items": {
            "$ref": "#/$defs/Profile"
          },
          "type": "array"
        }
      },
      "required": [
        "profiles"
      ],
      "type": "object"
    },
    "Rollout": {
      "description": "A staged rollout. The bucket comes from the household, so a home moves together.",
      "properties": {
        "name": {
          "type": "string"
        },
        "percent": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "percent"
      ],
      "type": "object"
    },
    "RouteTarget": {
      "description": "What an address opens.",
      "properties": {
        "code": {
          "description": "The code an approve address carried, as it stood in the address.",
          "type": "string"
        },
        "episode": {
          "$ref": "#/$defs/EpisodeRef"
        },
        "genre": {
          "description": "The genre, for the genre screen.",
          "type": "string"
        },
        "next": {
          "description": "A safe address to return to after sign in.",
          "type": "string"
        },
        "screen": {
          "$ref": "#/$defs/ScreenName"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "title": {
          "$ref": "#/$defs/TitleKey"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "ScreenBody": {
      "description": "A page body handed to a screen. It stands in for the answer to an http effect whose\nbody was going to the screen.",
      "properties": {
        "body": {
          "type": "string"
        },
        "request": {
          "description": "Id of the http effect this answers.",
          "type": "string"
        },
        "stale": {
          "default": false,
          "description": "True when this copy is past its ttl and was kept for when the network is gone.",
          "type": "boolean"
        }
      },
      "required": [
        "request",
        "body"
      ],
      "type": "object"
    },
    "ScreenName": {
      "description": "The screens the server builds.",
      "enum": [
        "home",
        "films",
        "series",
        "genre",
        "new",
        "my-list",
        "kids",
        "search",
        "notifications",
        "activity",
        "games",
        "clips",
        "language"
      ],
      "type": "string"
    },
    "SecretOp": {
      "description": "Secret operations.",
      "enum": [
        "get",
        "put",
        "delete"
      ],
      "type": "string"
    },
    "SessionState": {
      "description": "Where sign in stands.",
      "enum": [
        "starting",
        "signed_out",
        "signed_in"
      ],
      "type": "string"
    },
    "SessionView": {
      "description": "Sign in state for screens. Tokens never appear here.",
      "properties": {
        "email": {
          "type": "string"
        },
        "ended": {
          "$ref": "#/$defs/EndReason"
        },
        "expires_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "profile": {
          "type": "string"
        },
        "scope": {
          "description": "Opaque scope of this account and profile, the same value http effects carry.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "StoreOp": {
      "description": "Store operations. Only the offline layer uses store.",
      "enum": [
        "get",
        "put",
        "delete",
        "list"
      ],
      "type": "string"
    },
    "Target": {
      "description": "A semantic target. Each device maps it to one of its own screens.",
      "oneOf": [
        {
          "enum": [
            "start",
            "sign_in",
            "profiles",
            "home",
            "kids_home",
            "screen",
            "title",
            "watch",
            "not_found",
            "wait",
            "upgrade"
          ],
          "type": "string"
        },
        {
          "const": "activate",
          "description": "Approve or refuse a device that shows a code. It needs an account, even where visitors\nmay browse, and no profile.",
          "type": "string"
        }
      ]
    },
    "TimeWindow": {
      "description": "A span of a video the host compares to player time. Nothing ticks across the boundary.",
      "properties": {
        "end_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/WindowKind"
        },
        "seek_to_ms": {
          "description": "Where a skip button moves to.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "type": "object"
    },
    "TimerOp": {
      "description": "Timer operations. A clear uses the id of the timer it clears.",
      "enum": [
        "set",
        "clear"
      ],
      "type": "string"
    },
    "TitleKey": {
      "description": "movie:<id> or tv:<id>. A bare id does not parse.",
      "pattern": "^(movie|tv):[1-9][0-9]{0,9}$",
      "type": "string"
    },
    "VersionRange": {
      "description": "The wire dates a server answers. Never compared for equality.",
      "properties": {
        "max": {
          "$ref": "#/$defs/WireDate"
        },
        "min": {
          "$ref": "#/$defs/WireDate"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "View": {
      "description": "Changed screen state. A part that is absent did not change.",
      "properties": {
        "device_sign_in": {
          "$ref": "#/$defs/DeviceSignInView"
        },
        "gate": {
          "$ref": "#/$defs/GateView"
        },
        "hello": {
          "$ref": "#/$defs/Hello",
          "description": "The last hello read, so a screen takes limits and features from one place."
        },
        "play": {
          "$ref": "#/$defs/PlayView"
        },
        "profiles": {
          "$ref": "#/$defs/ProfileList",
          "description": "The account's profiles, for the picker. No PIN is ever held here."
        },
        "route": {
          "$ref": "#/$defs/RouteTarget"
        },
        "session": {
          "$ref": "#/$defs/SessionView"
        }
      },
      "type": "object"
    },
    "WindowKind": {
      "description": "Windows of time inside a video.",
      "enum": [
        "recap",
        "intro",
        "credits",
        "age_card",
        "cue"
      ],
      "type": "string"
    },
    "WireDate": {
      "description": "A wire date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One step of output.",
  "properties": {
    "contract": {
      "$ref": "#/$defs/WireDate"
    },
    "effects": {
      "items": {
        "$ref": "#/$defs/Effect"
      },
      "type": "array"
    },
    "next_wake_ms": {
      "description": "Monotonic time at which the host steps the core again. Absent means no wake.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/CoreOutTag"
    },
    "unsupported": {
      "description": "Ids of in events of a type this core does not know.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "view": {
      "$ref": "#/$defs/View"
    }
  },
  "required": [
    "contract",
    "type",
    "effects"
  ],
  "title": "CoreOut",
  "type": "object"
}
