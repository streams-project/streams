    }
   ],
   "want": {
    "pages": [
     {
      "page": {
       "ttl_s": 600
      }
     },
     {
      "page": {
       "name": "my-list"
      }
     }
    ],
    "view": {
     "route": {
      "screen": "my-list",
      "target": "screen"
     }
    }
   }
  }
 ],
 "name": "the_pick_keeps_the_address_under_it"
}
