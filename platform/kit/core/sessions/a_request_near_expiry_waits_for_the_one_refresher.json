{
 "about": "A request with under 120 s left waits behind one refresh and goes with the new token.",
 "covers": [
  "C7",
  "C71"
 ],
 "moments": [
  {
   "at_ms": 0
  },
  {
   "at_ms": 100,
   "events": [
    {
     "action": {
      "action": "sign_in",
      "email": "viewer@host.example",
      "password": "sample-pass"
     },
     "type": "action"
    }
   ]
  },
  {
   "at_ms": 200,
   "events": [
    {
     "action": {
      "action": "enter_profile",
      "profile": "p1"
     },
     "type": "action"
    }
   ]
  },
  {
   "at_ms": 4000,
   "want": {
    "wake": 5100
   }
  },
  {
   "at_ms": 4900,
   "net": "down"
  },
  {
   "at_ms": 5200,
   "want": {
    "sent": [
     "POST /v1/auth/refresh"
    ],
    "wake": 10100
   }
  },
  {
   "at_ms": 5300,
   "net": "up"
  },
  {
   "at_ms": 5400,
   "events": [
    {
     "online": true,
     "type": "network"
    },
    {
     "address": "/browse/genre/34399",
     "type": "address"
    },
    {
     "address": "/browse/my-list",
     "type": "address"
    }
   ],
   "want": {
    "bearers": [
     "access-2",
     "access-2"
    ],
    "view": {
     "route": {
      "screen": "my-list",
      "target": "screen"
     }
    }
   }
  }
 ],
 "name": "a_request_near_expiry_waits_for_the_one_refresher",
 "server": [
  {
   "body": {
    "access_token": "access-1",
    "email": "viewer@host.example",
    "expires_in": 125,
    "refresh_token": "refresh-1",
    "user_id": "u1"
   },
   "method": "POST",
   "path": "/v1/auth/password"
  },
  {
   "body": {
    "name": "films",
    "sections": [],
    "ttl_s": 60
   },
   "method": "GET",
   "path": "/v1/screens/films"
  }
 ]
}
