{
 "about": "The core asks for the code, polls with the interval, slows down when told, and the tokens reach the normal sign in. The host only draws the view.",
 "config": {
  "app": "sample-tv",
  "class": "tv",
  "contract": "2026-11-05",
  "form": "tv",
  "mode": "local",
  "os": "sample-os",
  "seed": "00112233445566778899aabbccddeeff",
  "type": "core_config",
  "version": "1.0.0"
 },
 "covers": [
  "N9"
 ],
 "moments": [
  {
   "at_ms": 0
  },
  {
   "at_ms": 100,
   "events": [
    {
     "address": "/login",
     "type": "address"
    },
    {
     "action": {
      "action": "device_sign_in",
      "device_name": "Living room TV"
     },
     "type": "action"
    }
   ],
   "want": {
    "bodies": {
     "/v1/auth/device/code": [
      {
       "device_name": "Living room TV"
      }
     ]
    },
    "routes": [
     {
      "target": "sign_in"
     }
    ],
    "sent": [
     "POST /v1/auth/device/code"
    ],
    "view": {
     "device_sign_in": {
      "expires_in": 900,
      "state": "waiting",
      "user_code": "BCDFGHJK",
      "verification_uri": "https://sign.example/tv",
      "verification_uri_complete": "https://sign.example/tv?code=BCDFGHJK"
     },
     "session": {
      "state": "signed_out"
     }
    },
    "wake": 5100
   }
  },
  {
   "at_ms": 5100,
   "want": {
    "bodies": {
     "/v1/auth/device/token": [
      {
       "device_code": "device-code-1"
      }
     ]
    },
    "sent": [
     "POST /v1/auth/device/token"
    ],
    "wake": 10100
   }
  },
  {
   "at_ms": 10100,
   "want": {
    "sent": [
     "POST /v1/auth/device/token"
    ],
    "wake": 20100
   }
  },
  {
   "at_ms": 20100,
   "want": {
    "notices": [],
    "routes": [
     {
      "target": "profiles"
     }
    ],
    "secrets": [
     "device",
     "session"
    ],
    "sent": [
     "POST /v1/auth/device/token",
     "GET /v1/profiles"
    ],
    "view": {
     "device_sign_in": {
      "state": "idle",
      "user_code": null
     },
     "session": {
      "state": "signed_in",
      "user_id": "u1"
     }
    }
   }
  },
  {
   "at_ms": 30000,
   "want": {
    "sent": []
   }
  },
  {
   "at_ms": 31000,
   "events": [
    {
     "action": {
      "action": "enter_profile",
      "profile": "p1"
     },
     "type": "action"
    }
   ],
   "want": {
    "routes": [
     {
      "target": "home"
     }
    ]
   },
   "want_off": {
    "bearers": [
     "access-1",
     "access-1",
     "access-1"
    ],
    "sent": [
     "POST /v1/profiles/p1/enter",
     "GET /v1/nav",
     "GET /v1/screens/home"
    ]
   },
   "want_on": {
    "bearers": [
     "access-1",
     "access-1",
     "access-1",
     "access-1"
    ],
    "sent": [
     "POST /v1/profiles/p1/enter",
     "GET /v1/nav",
     "GET /v1/screens/home",
     "GET /v1/changes"
    ]
   }
  }
 ],
 "name": "a_tv_signs_in_with_a_code_approved_on_another_screen",
 "server": [
  {
   "body": {
    "device_code": "device-code-1",
    "expires_in": 900,
    "interval": 5,
    "user_code": "BCDFGHJK",
    "verification_uri": "https://sign.example/tv",
    "verification_uri_complete": "https://sign.example/tv?code=BCDFGHJK"
   },
   "method": "POST",
   "path": "/v1/auth/device/code"
  },
  {
   "body": {
    "poll": "authorization_pending"
   },
   "method": "POST",
   "path": "/v1/auth/device/token",
   "times": 1
  },
  {
   "body": {
    "poll": "slow_down"
   },
   "method": "POST",
   "path": "/v1/auth/device/token",
   "times": 1
  },
  {
   "body": {
    "signed_in": {
     "access_token": "access-1",
     "email": "viewer@host.example",
     "expires_in": 900,
     "refresh_token": "refresh-1",
     "user_id": "u1"
    }
   },
   "method": "POST",
   "path": "/v1/auth/device/token"
  }
 ]
}
